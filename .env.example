# Adobe Acrobat Sign
ADOBE_SIGN_CLIENT_ID="your-client-id"
ADOBE_SIGN_CLIENT_SECRET="your-client-secret"
ADOBE_SIGN_REDIRECT_URI="http://localhost:3000/api/adobe-sign/callback"
ADOBE_SIGN_BASE_URI="https://api.na2.adobesign.com/"

